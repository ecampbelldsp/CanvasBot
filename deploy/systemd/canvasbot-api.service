[Unit]
Description=CanvasBot FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=canvasbot
Group=canvasbot
WorkingDirectory=/opt/canvasbot
EnvironmentFile=/etc/canvasbot.env
ExecStart=/opt/canvasbot/.venv-app/bin/canvasbot-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
